upstream photoz_web {
    server web:8000;
}

server {
    listen 80;

    client_max_body_size 20M;
    client_body_buffer_size 20M;

    location / {
        proxy_pass http://photoz_web;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Host $host;
        proxy_redirect off;
    }

    location /static/ {
        alias /app/staticfiles/;
    }
}
