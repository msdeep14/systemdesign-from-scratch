{
  "$schema": "https://calm.finos.org/release/1.2/meta/calm.json",
  "$id": "https://raw.githubusercontent.com/msdeep14/systemdesignfromscratch/main/photoz/architecture/photoz.calm.json",
  "title": "Photoz Architecture",
  "description": "A photo-sharing social network architecture.",
  "nodes": [
    {
      "unique-id": "end-user",
      "node-type": "actor",
      "name": "Photoz User",
      "description": "A user interacting with the Photoz social network via web browser or mobile app."
    },
    {
      "unique-id": "load-balancer",
      "node-type": "service",
      "name": "Nginx Load Balancer",
      "description": "Routes incoming traffic to available app servers and serves static assets."
    },
    {
      "unique-id": "web-app",
      "node-type": "service",
      "name": "Django App Servers",
      "description": "Horizontally scalable application servers handling business logic."
    },
    {
      "unique-id": "primary-db",
      "node-type": "service",
      "name": "Primary PostgreSQL Database",
      "description": "Stores user profiles, photos metadata, communities, and relationships."
    },
    {
      "unique-id": "replica-db",
      "node-type": "service",
      "name": "Read Replica PostgreSQL Database",
      "description": "Read-only database replicas for scaling read queries."
    },
    {
      "unique-id": "redis-primary",
      "node-type": "service",
      "name": "Redis Primary Cache",
      "description": "In-memory cache master handling all write operations, like counters, user like sets, and replication."
    },
    {
      "unique-id": "redis-replica",
      "node-type": "service",
      "name": "Redis Read Replicas",
      "description": "In-memory cache replicas for horizontally scaling read operations and feed queries."
    },
    {
      "unique-id": "redis-sentinel",
      "node-type": "service",
      "name": "Redis Sentinel Cluster",
      "description": "Distributed consensus monitoring nodes (quorum 2) providing automated health tracking and master failover."
    },
    {
      "unique-id": "cdn",
      "node-type": "service",
      "name": "CloudFront CDN",
      "description": "Caches and serves uploaded images globally."
    },
    {
      "unique-id": "s3",
      "node-type": "service",
      "name": "Amazon S3",
      "description": "Object storage for uploaded photos."
    },
    {
      "unique-id": "kafka-cluster",
      "node-type": "service",
      "name": "Kafka Cluster (KRaft)",
      "description": "Distributed event streaming platform and commit log for asynchronous decoupling."
    },
    {
      "unique-id": "kafka-consumers",
      "node-type": "service",
      "name": "Kafka Consumer Daemons",
      "description": "Background consumer processes that pull events from Kafka and persist batch writes."
    }
  ],
  "relationships": [
    {
      "unique-id": "lb-to-webapp",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "load-balancer"
          },
          "destination": {
            "node": "web-app"
          }
        }
      },
      "protocol": "HTTP",
      "description": "Routes dynamic traffic to"
    },
    {
      "unique-id": "webapp-to-primarydb",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "web-app"
          },
          "destination": {
            "node": "primary-db"
          }
        }
      },
      "protocol": "TCP",
      "description": "Reads from and writes to"
    },
    {
      "unique-id": "webapp-to-replicadb",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "web-app"
          },
          "destination": {
            "node": "replica-db"
          }
        }
      },
      "protocol": "TCP",
      "description": "Reads from"
    },
    {
      "unique-id": "primarydb-to-replicadb",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "primary-db"
          },
          "destination": {
            "node": "replica-db"
          }
        }
      },
      "protocol": "TCP",
      "description": "Replicates data to"
    },
    {
      "unique-id": "webapp-to-redis-sentinel",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "web-app"
          },
          "destination": {
            "node": "redis-sentinel"
          }
        }
      },
      "protocol": "TCP",
      "description": "Discovers active master and topology from"
    },
    {
      "unique-id": "webapp-to-redis-primary",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "web-app"
          },
          "destination": {
            "node": "redis-primary"
          }
        }
      },
      "protocol": "TCP",
      "description": "Writes cache keys, like counters, and locks to"
    },
    {
      "unique-id": "webapp-to-redis-replica",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "web-app"
          },
          "destination": {
            "node": "redis-replica"
          }
        }
      },
      "protocol": "TCP",
      "description": "Reads newsfeed lists and cache keys from"
    },
    {
      "unique-id": "webapp-to-s3",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "web-app"
          },
          "destination": {
            "node": "s3"
          }
        }
      },
      "protocol": "HTTPS",
      "description": "Uploads photos"
    },
    {
      "unique-id": "cdn-to-s3",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "cdn"
          },
          "destination": {
            "node": "s3"
          }
        }
      },
      "protocol": "HTTPS",
      "description": "Fetches images from origin"
    },
    {
      "unique-id": "user-to-lb",
      "relationship-type": {
        "interacts": {
          "actor": "end-user",
          "nodes": [
            "load-balancer"
          ]
        }
      },
      "description": "Browses the site, manages profile, and uploads photos"
    },
    {
      "unique-id": "user-to-cdn",
      "relationship-type": {
        "interacts": {
          "actor": "end-user",
          "nodes": [
            "cdn"
          ]
        }
      },
      "description": "Downloads and views photos"
    },
    {
      "unique-id": "webapp-to-kafka",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "web-app"
          },
          "destination": {
            "node": "kafka-cluster"
          }
        }
      },
      "protocol": "TCP",
      "description": "Publishes asynchronous events to"
    },
    {
      "unique-id": "consumers-to-kafka",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "kafka-consumers"
          },
          "destination": {
            "node": "kafka-cluster"
          }
        }
      },
      "protocol": "TCP",
      "description": "Consumes event batches from"
    },
    {
      "unique-id": "consumers-to-primarydb",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "kafka-consumers"
          },
          "destination": {
            "node": "primary-db"
          }
        }
      },
      "protocol": "TCP",
      "description": "Bulk writes and updates"
    },
    {
      "unique-id": "primary-to-replica-redis",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "redis-primary"
          },
          "destination": {
            "node": "redis-replica"
          }
        }
      },
      "protocol": "TCP",
      "description": "Replicates in-memory data to"
    },
    {
      "unique-id": "sentinel-to-redis-primary",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "redis-sentinel"
          },
          "destination": {
            "node": "redis-primary"
          }
        }
      },
      "protocol": "TCP",
      "description": "Monitors health and triggers failover for"
    },
    {
      "unique-id": "sentinel-to-redis-replica",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "redis-sentinel"
          },
          "destination": {
            "node": "redis-replica"
          }
        }
      },
      "protocol": "TCP",
      "description": "Monitors and reconfigures"
    },
    {
      "unique-id": "consumers-to-redis-primary",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "kafka-consumers"
          },
          "destination": {
            "node": "redis-primary"
          }
        }
      },
      "protocol": "TCP",
      "description": "Updates and invalidates cache keys in"
    },
    {
      "unique-id": "consumers-to-redis-sentinel",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "kafka-consumers"
          },
          "destination": {
            "node": "redis-sentinel"
          }
        }
      },
      "protocol": "TCP",
      "description": "Discovers active master address from"
    }
  ]
}
